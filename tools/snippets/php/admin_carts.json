    "create_admin_cart": {
      "function": "createAdminCart",
      "code": "use WebCommander\\Resources\\Carts\\AdminCarts;\n\n$response = AdminCarts::createAdminCart($client, [\n    'customer_id' => 512,\n    'products' => [['product_id' => 101, 'quantity' => 2]],\n]);\n\n$cart = $response->map['cart'];\necho $cart['session']['session_id'], ' ', $cart['totals']['grand_total'], PHP_EOL;"
    },
    "get_admin_cart": {
      "function": "getAdminCart",
      "code": "use WebCommander\\Resources\\Carts\\AdminCarts;\n\n$response = AdminCarts::getAdminCart($client, 'PRV-3f2a9c41b7d80e65');\n\n$cart = $response->map['cart'];\necho $cart['session']['expires_at'], ' ', $cart['totals']['grand_total'], PHP_EOL;"
