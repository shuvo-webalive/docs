      "function": "updateCheckout",
      "code": "use WebCommander\\Resources\\Carts\\AdminCarts;\n\n$response = AdminCarts::updateCheckout($client, 'PRV-3f2a9c41b7d80e65', [\n    'delivery_type' => 'shipping',\n    'billing_address' => [\n        'first_name' => 'Jane',\n        'last_name' => 'Doe',\n        'email' => 'jane.doe@example.com',\n        'address_line_1' => '1 Example Street',\n        'city' => 'Melbourne',\n        'post_code' => '3000',\n        'phone' => '0300000000',\n        'country_code' => 'AU',\n        'state_code' => 'VIC',\n    ],\n    'shipping_address' => [\n        'first_name' => 'Jane',\n        'last_name' => 'Doe',\n        'email' => 'jane.doe@example.com',\n        'address_line_1' => '1 Example Street',\n        'city' => 'Melbourne',\n        'post_code' => '3000',\n        'phone' => '0300000000',\n        'country_code' => 'AU',\n        'state_code' => 'VIC',\n    ],\n]);\n\n$checkout = $response->map['checkout'];\necho $checkout['shipping']['shipping_cost'], ' ', $checkout['totals']['grand_total'], PHP_EOL;"
