{
  "sdk": "js",
  "module": "search_result_page",
  "endpoints": {
    "get_search_result_page": {
      "function": "getSearchResultPage",
      "code": "const response = await client.searchResultPage.getSearchResultPage();\nconst information = response.map.search_result_page.product_information;\nconsole.log(information.display_short_description, information.number_of_searches_per_result.items_per_page);\n"
    },
    "patch_search_result_page": {
      "function": "patchSearchResultPage",
      "code": "const response = await client.searchResultPage.patchSearchResultPage({\n    search_result_page: {product_information: {display_short_description: true}},\n});\nconsole.log(response.map.search_result_page.product_information.display_short_description);\n"
    },
    "head_search_result_page": {
      "function": "headSearchResultPage",
      "code": "const response = await client.searchResultPage.headSearchResultPage();\nconsole.log(response.statusCode);\n"
    },
    "get_search_result_page_section": {
      "function": "getSearchResultPageSection",
      "code": "const response = await client.searchResultPage.getSearchResultPageSection('product_information');\nconst information = response.map.search_result_page.product_information;\nconsole.log(information.display_short_description, information.set_product_display_preferences.display_mode);\n"
    },
    "patch_search_result_page_section": {
      "function": "patchSearchResultPageSection",
      "code": "const response = await client.searchResultPage.patchSearchResultPageSection('product_information', {\n    product_information: {display_short_description: true},\n});\nconsole.log(response.map.search_result_page.product_information.display_short_description);\n"
    },
    "get_search_result_page_product_promotions": {
      "function": "getSearchResultPageProductPromotions",
      "code": "const response = await client.searchResultPage.getSearchResultPageProductPromotions();\nfor (const promotion of response.map.product_promotions) {\n    console.log(promotion.id, promotion.name, promotion.position, promotion.is_active);\n}\n"
    },
    "create_search_result_page_product_promotion": {
      "function": "createSearchResultPageProductPromotion",
      "code": "const response = await client.searchResultPage.createSearchResultPageProductPromotion({\n    product_promotion: {name: 'Spring campaign', rule: 'all_search_result', position: 'top'},\n});\nconsole.log(response.map.product_promotion.id);\n"
    },
    "get_search_result_page_product_promotion": {
      "function": "getSearchResultPageProductPromotion",
      "code": "const response = await client.searchResultPage.getSearchResultPageProductPromotion(4);\nconst promotion = response.map.product_promotion;\nconsole.log(promotion.name, promotion.rule, promotion.position, promotion.is_active);\n"
    },
    "patch_search_result_page_product_promotion": {
      "function": "patchSearchResultPageProductPromotion",
      "code": "const response = await client.searchResultPage.patchSearchResultPageProductPromotion(6, {\n    product_promotion: {position: 'bottom'},\n});\nconsole.log(response.map.product_promotion.position);\n"
    },
    "patch_search_result_page_product_promotion_active": {
      "function": "patchSearchResultPageProductPromotionActive",
      "code": "const response = await client.searchResultPage.patchSearchResultPageProductPromotionActive(6, {\n    product_promotion: {is_active: false},\n});\nconsole.log(response.map.product_promotion.is_active);\n"
    },
    "delete_search_result_page_product_promotion": {
      "function": "deleteSearchResultPageProductPromotion",
      "code": "const response = await client.searchResultPage.deleteSearchResultPageProductPromotion(6);\nconsole.log(response.statusCode);\n"
    }
  }
}
