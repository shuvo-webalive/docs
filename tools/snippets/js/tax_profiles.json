{
  "sdk": "js",
  "module": "tax_profiles",
  "endpoints": {
    "list_tax_profiles": {
      "function": "listTaxProfiles",
      "code": "const response = await client.taxProfiles.listTaxProfiles({limit: 20});\nfor (const taxProfile of response.map.tax_profiles) {\n    console.log(taxProfile.id, taxProfile.name, taxProfile.default);\n}\nconsole.log(response.map.pagination.total);\n"
    },
    "head_tax_profiles": {
      "function": "headTaxProfiles",
      "code": "const response = await client.taxProfiles.headTaxProfiles();\nconsole.log(response.statusCode);\n"
    },
    "create_tax_profile": {
      "function": "createTaxProfile",
      "code": "const response = await client.taxProfiles.createTaxProfile({\n    tax_profile: {name: 'Wholesale', description: 'Profile for wholesale customers'},\n});\nconsole.log(response.map.tax_profile.id);\n"
    },
    "get_tax_profile": {
      "function": "getTaxProfile",
      "code": "const response = await client.taxProfiles.getTaxProfile(2);\nconsole.log(response.map.tax_profile.name, response.map.tax_profile.default);\n"
    },
    "head_tax_profile": {
      "function": "headTaxProfile",
      "code": "const response = await client.taxProfiles.headTaxProfile(2);\nconsole.log(response.statusCode);\n"
    },
    "update_tax_profile": {
      "function": "updateTaxProfile",
      "code": "const response = await client.taxProfiles.updateTaxProfile(4, {tax_profile: {name: 'Wholesale AU'}});\nconsole.log(response.map.tax_profile.name);\n"
    },
    "delete_tax_profile": {
      "function": "deleteTaxProfile",
      "code": "const response = await client.taxProfiles.deleteTaxProfile(4);\nconsole.log(response.statusCode);\n"
    }
  }
}
