{
  "sdk": "js",
  "module": "shipping_methods",
  "endpoints": {
    "list_shipping_methods": {
      "function": "listShippingMethods",
      "code": "const response = await client.shippingMethods.listShippingMethods({limit: 20});\nfor (const shippingMethod of response.map.shipping_methods) {\n    console.log(shippingMethod.id, shippingMethod.name, shippingMethod.is_default);\n}\n"
    },
    "head_shipping_methods": {
      "function": "headShippingMethods",
      "code": "const response = await client.shippingMethods.headShippingMethods();\nconsole.log(response.statusCode);\n"
    },
    "count_shipping_methods": {
      "function": "countShippingMethods",
      "code": "const response = await client.shippingMethods.countShippingMethods();\nconsole.log(response.map.shipping_methods.count);\n"
    },
    "create_shipping_method": {
      "function": "createShippingMethod",
      "code": "const response = await client.shippingMethods.createShippingMethod({shipping_method: {name: 'Express Post'}});\nconsole.log(response.map.shipping_method.id);\n"
    },
    "get_shipping_method": {
      "function": "getShippingMethod",
      "code": "const response = await client.shippingMethods.getShippingMethod(2);\nconsole.log(response.map.shipping_method.name, response.map.shipping_method.is_default);\n"
    },
    "head_shipping_method": {
      "function": "headShippingMethod",
      "code": "const response = await client.shippingMethods.headShippingMethod(2);\nconsole.log(response.statusCode);\n"
    },
    "update_shipping_method": {
      "function": "updateShippingMethod",
      "code": "const response = await client.shippingMethods.updateShippingMethod(4, {\n    shipping_method: {name: 'Express Post Next Day'},\n});\nconsole.log(response.map.shipping_method.name);\n"
    },
    "delete_shipping_method": {
      "function": "deleteShippingMethod",
      "code": "const response = await client.shippingMethods.deleteShippingMethod(4);\nconsole.log(response.statusCode);\n"
    },
    "set_shipping_method_default": {
      "function": "setShippingMethodDefault",
      "code": "const response = await client.shippingMethods.setShippingMethodDefault(2);\nconsole.log(response.map.shipping_method.is_default);\n"
    }
  }
}
