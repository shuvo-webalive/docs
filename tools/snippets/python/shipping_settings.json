{
  "sdk": "python",
  "module": "shipping_settings",
  "endpoints": {
    "get_shipping_settings": {
      "function": "get_shipping_settings",
      "code": "response = client.shipping_settings.get_shipping_settings()\nsettings = response.map[\"shipping_settings\"]\nprint(settings[\"default_shipping_profile\"], settings[\"shipping_tax_profile\"])\nprint(settings[\"enable_shipping_class\"], settings[\"enable_class_in_flat_view\"])\n"
    },
    "patch_shipping_settings": {
      "function": "patch_shipping_settings",
      "code": "response = client.shipping_settings.patch_shipping_settings({\n    \"shipping_settings\": {\"apply_store_tax_settings_to_shipping\": True},\n})\nprint(response.map[\"shipping_settings\"][\"apply_store_tax_settings_to_shipping\"])\n"
    },
    "head_shipping_settings": {
      "function": "head_shipping_settings",
      "code": "response = client.shipping_settings.head_shipping_settings()\nprint(response.status_code)\n"
    }
  }
}
