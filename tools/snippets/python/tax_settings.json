{
  "sdk": "python",
  "module": "tax_settings",
  "endpoints": {
    "get_tax_settings": {
      "function": "get_tax_settings",
      "code": "response = client.tax_settings.get_tax_settings()\nsettings = response.map[\"tax_settings\"]\nprint(settings[\"tax_rate_for_customers\"], settings[\"prices_in_catalog\"])\nprint(settings[\"is_price_shown_with_tax\"], settings[\"tax_message\"])\n"
    },
    "put_tax_settings": {
      "function": "put_tax_settings",
      "code": "response = client.tax_settings.put_tax_settings({\n    \"tax_settings\": {\"tax_message\": \"All prices include GST\"},\n})\nprint(response.map[\"tax_settings\"][\"tax_message\"])\n"
    },
    "patch_tax_settings": {
      "function": "patch_tax_settings",
      "code": "response = client.tax_settings.patch_tax_settings({\n    \"tax_settings\": {\"is_price_shown_with_tax\": True},\n})\nprint(response.map[\"tax_settings\"][\"is_price_shown_with_tax\"])\n"
    }
  }
}
